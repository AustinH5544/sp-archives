# Workers static assets — response header overrides.
# Parsed by Cloudflare, never served as an asset itself.
#
# Cloudflare's default for every asset is:
#   Cache-Control: public, max-age=0, must-revalidate
# which is correct for HTML (a redeploy must be visible immediately) but
# wasteful for everything below. Rules here override that default.

# Next.js fingerprints these filenames with a content hash, so a changed
# file is a changed URL and the browser can hold onto it forever.
# Covers JS, CSS, and the self-hosted next/font woff2 files under media/.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs are NOT fingerprinted — they are 01.jpg, 02.jpg, cover.jpg.
# "immutable" would mean a replaced frame never reaches a returning
# visitor, so this is a plain TTL instead: one day of no revalidation,
# and at worst one day of staleness if Skyelar swaps a plate in place.
# Rename the file (or bump the folder) if a swap must be seen instantly.
/work/*
  Cache-Control: public, max-age=86400

# Keep preview builds out of search results. Preview URLs are opt-in and
# currently off for this Worker, but non-production branch builds are
# enabled, so this guards the case where they get turned on later.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
